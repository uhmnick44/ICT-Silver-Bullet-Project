# Raw Databento downloads are never committed
data/raw/
*.zip
*.dbn
*.dbn.zst
__pycache__/

# ict_lab: raw vendor data and large derived datasets are never committed
ict_lab/data/raw/*.zip
ict_lab/data/raw/_extracted/
ict_lab/data/clean/*.parquet
ict_lab/data/clean/contracts/
ict_lab/data/clean/partitioned/
ict_lab/runs/roll_charts/
ict_lab/runs/pipeline_run_*.json
.pytest_cache/
ict_lab/runs/features/**/*.parquet
ict_lab/runs/features_full_run.log
ict_lab/runs/backtests/**/*.parquet
